# Store text files with LF line endings. Files that run inside Linux containers must stay LF
# even when checked out on Windows, otherwise scripts and configs break.
* text=auto
*.sh text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files: never convert
*.pkl binary
*.png binary
*.ico binary
*.woff2 binary
