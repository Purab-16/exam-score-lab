{
  "permissions": {
    "ask": [
      "Bash(git *)",
      "Bash(gh *)",
      "PowerShell(git *)",
      "PowerShell(gh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask_before_git.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
